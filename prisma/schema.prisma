// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["public", "system-auth"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  cpf           String
  contact       String
  dateOfBirth   DateTime
  gender        String    @default("unspecified")
  address       String?
  role          String    @default("member")
  permission    String    @default("read")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  sessions      Session[]
  accounts      Account[]
  assisted      BeneficiaryAssistant[]
  createdFoods           Food[]           @relation("FoodCreatedBy")
  foodHistories          FoodHistory[]    @relation("FoodHistoryCreatedBy")
  createdBasketTemplates BasketTemplate[] @relation("BasketTemplateCreatedBy")
  createdBaskets         Basket[]         @relation("BasketCreatedBy")
  basketHistories        BasketHistory[]  @relation("BasketHistoryCreatedBy")
  auditLogs              AuditLog[]       @relation("AuditLogActor")

  @@unique([email])
  @@unique([cpf])
  @@index([role])
  @@map("user")
  @@schema("system-auth")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("system-auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("system-auth")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier]) 
  @@map("verification")
  @@schema("system-auth")
}

model Beneficiary {
  id            String                 @id @default(uuid())
  name          String
  cpf           String?
  street        String
  neighborhood  String
  city          String
  state         String
  email         String?
  dateOfBirth   DateTime
  gender        String
  maritalStatus String
  employment    String
  profession    String?
  notes         String?
  status        String
  aidType       String
  expectedDeliveryDay Int?
  disability    String
  rent          String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  contacts        BeneficiaryContact[]
  members         FamilyMember[]
  assistants      BeneficiaryAssistant[]
  foodHistories   FoodHistory[]
  basketHistories BasketHistory[]

  @@unique([cpf])
  @@index([name])
  @@map("beneficiary")
  @@schema("public")
}

model BeneficiaryAssistant {
  beneficiaryId String
  userId        String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([beneficiaryId, userId])
  @@index([userId])
  @@map("beneficiary_assistant")
  @@schema("public")
}

model BeneficiaryContact {
  id            String      @id @default(uuid())
  phone         String
  position      Int
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([beneficiaryId])
  @@map("beneficiary_contact")
  @@schema("public")
}

model FamilyMember {
  id             String                @id @default(uuid())
  beneficiaryId  String
  beneficiary    Beneficiary           @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  name           String
  kinship        String
  cpf            String?
  street         String?
  neighborhood   String?
  city           String?
  state          String?
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  maritalStatus  String?
  employment     String?
  profession     String?
  notes          String?
  status         String?
  aidType        String?
  expectedDeliveryDay Int?
  disability     String?
  rent           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  contacts       FamilyMemberContact[]

  @@unique([cpf])
  @@index([beneficiaryId])
  @@index([name])
  @@map("family_member")
  @@schema("public")
}

model FamilyMemberContact {
  id             String       @id @default(uuid())
  phone          String
  position       Int
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([familyMemberId])
  @@map("family_member_contact")
  @@schema("public")
}


model Food {
  id            String               @id @default(uuid())
  label         String
  type          String
  expiresAt     DateTime?
  brand         String?
  quantity      Int                  @default(1)
  batch         String               @unique
  productCode   String?
  createdById   String?
  createdBy     User?                @relation("FoodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  templateItems BasketTemplateFood[]
  basketItems   BasketFood[]
  histories     FoodHistory[]

  @@index([label])
  @@index([expiresAt])
  @@index([type])
  @@index([createdById])
  @@map("food")
  @@schema("public")
}

model FoodHistory {
  id              String       @id @default(uuid())
  foodId          String?
  food            Food?        @relation(fields: [foodId], references: [id], onDelete: SetNull)
  foodLabel       String
  foodBatch       String
  type            String
  quantity        Int
  description     String
  beneficiaryId   String?
  beneficiary     Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  beneficiaryName String?
  justification   String?
  createdById     String?
  createdBy       User?        @relation("FoodHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName   String
  createdAt       DateTime     @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([foodId])
  @@index([beneficiaryId])
  @@index([createdById])
  @@map("food_history")
  @@schema("public")
}

model BasketTemplate {
  id            String               @id @default(uuid())
  name          String               @unique
  createdById   String?
  createdBy     User?                @relation("BasketTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  foods         BasketTemplateFood[]
  baskets       Basket[]

  @@index([name])
  @@index([createdById])
  @@map("basket_template")
  @@schema("public")
}

model BasketTemplateFood {
  templateId String
  foodId     String
  template   BasketTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  food       Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([templateId, foodId])
  @@index([foodId])
  @@map("basket_template_food")
  @@schema("public")
}

model BasketSequence {
  dateKey    String @id
  lastNumber Int    @default(0)

  @@map("basket_sequence")
  @@schema("public")
}

model Basket {
  id            String          @id @default(uuid())
  name          String          @unique
  quantity      Int             @default(1)
  templateId          String?
  template            BasketTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deletedTemplateName String?
  createdById   String?
  createdBy     User?           @relation("BasketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  foods         BasketFood[]
  histories     BasketHistory[]

  @@index([quantity])
  @@index([createdAt(sort: Desc)])
  @@index([templateId])
  @@index([createdById])
  @@map("basket")
  @@schema("public")
}

model BasketFood {
  basketId String
  foodId   String
  basket   Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  food     Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([basketId, foodId])
  @@index([foodId])
  @@map("basket_food")
  @@schema("public")
}

model BasketHistory {
  id              String       @id @default(uuid())
  basketId        String?
  basket          Basket?      @relation(fields: [basketId], references: [id], onDelete: SetNull)
  basketName      String
  type            String
  quantity        Int
  description     String
  beneficiaryId   String?
  beneficiary     Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  beneficiaryName String?
  justification   String?
  createdById     String?
  createdBy       User?        @relation("BasketHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName   String
  createdAt       DateTime     @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([basketId])
  @@index([beneficiaryId])
  @@index([createdById])
  @@map("basket_history")
  @@schema("public")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
  @@schema("system-auth")
}

model SecurityRateLimit {
  key           String    @id
  attempts      Int       @default(0)
  windowStartAt DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([updatedAt])
  @@map("security_rate_limit")
  @@schema("system-auth")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  description String
  actorId     String?
  actor       User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
  @@schema("public")
}
